{
  "name": "semana01-proyecto-constructora",
  "version": "1.0.0",
  "description": "Proyecto semanal — Procesador de datos con Node.js + TypeScript (Constructora)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "start": "node dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
