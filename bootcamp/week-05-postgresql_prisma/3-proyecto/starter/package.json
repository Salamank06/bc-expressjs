{
  "name": "semana05-postgresql-prisma-constructora",
  "version": "1.0.0",
  "description": "API REST con PostgreSQL + Prisma ORM para obras de construcción con relación 1:N Proyecto ↔ Avance (dominio: Constructora)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.18.0",
    "express": "5.1.0",
    "morgan": "1.10.1",
    "winston": "3.19.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/morgan": "1.9.10",
    "@types/node": "22.15.21",
    "prisma": "6.18.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
